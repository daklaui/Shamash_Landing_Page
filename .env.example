# Keep the intended company domain. Change only after its DNS/TLS configuration is approved.
SITE_ORIGIN=https://www.shamash-it.com
# Set true for the primary production deployment, false for previews. Defaults follow VERCEL_ENV.
SITE_INDEXABLE=false
# Choose ONE delivery method. Keep credentials in server environment variables.
# HTTPS endpoint contract: POST JSON, Idempotency-Key header, 2xx JSON {"accepted":true} after durable acceptance.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Optional self-hosted durable outbox, absolute path outside public. Requires an operator/consumer and retention policy.
# Do not use ephemeral Vercel storage for this option.
CONTACT_STORAGE_DIR=
